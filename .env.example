# Строка подключения к Postgres. База должна быть отдельной, создаётся командой
# `sound-loops init-db` в уже работающем локальном инстансе Postgres.
DATABASE_URL=postgresql://localhost:5432/sound_loops

# Опционально — значения по умолчанию показаны ниже, менять не обязательно.
# LOOPS_DIR=data/loops
# MUSIC_DIR=data/raw/fma_small
# METADATA_CSV=data/raw/fma_metadata/tracks.csv
# OUTPUT_DIR=data/renders
# MIN_LOOP_SECONDS=3
# MAX_LOOP_SECONDS=10
# FADE_SECONDS=0.3
